NODE_ENV=production
HOST=127.0.0.1
PORT=5000

FRONTEND_URL=https://socialbird.31.207.74.138.nip.io
FRONTEND_URLS=https://socialbird.31.207.74.138.nip.io

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=socialbird
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_NAME=socialbird
DB_CONNECTION_LIMIT=10

JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES=7d

SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

GITHUB_PERSONAL_ACCESS_TOKEN=
GITLAB_PERSONAL_ACCESS_TOKEN=

MAX_UPLOAD_BYTES=26214400
JSON_BODY_LIMIT=2mb
WS_MAX_PAYLOAD_BYTES=1048576
WS_HEARTBEAT_MS=30000

# The API forwards code to a private Unix-socket runner. It never starts compilers itself.
ENABLE_COMPILER=true
COMPILER_SOCKET=/run/socialbird-compiler/runner.sock
COMPILER_REQUEST_TIMEOUT_MS=12000
COMPILER_MAX_CODE_BYTES=200000
COMPILER_RUNS_PER_MINUTE=10
COMPILER_MAX_ACTIVE_PER_USER=1
